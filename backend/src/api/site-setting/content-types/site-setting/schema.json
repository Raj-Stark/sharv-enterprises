{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting",
    "description": "Company and product enquiry contact details"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "companyName": {
      "type": "string",
      "required": true,
      "default": "Sharv Enterprises"
    },
    "enquiryEmail": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "whatsappNumber": {
      "type": "string",
      "required": true,
      "default": "+91 98188 36151",
      "maxLength": 30
    },
    "defaultInquiryMessage": {
      "type": "text",
      "maxLength": 300
    }
  }
}
