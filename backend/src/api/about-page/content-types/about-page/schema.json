{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page",
    "description": "Editable content and optional hero image for the public About page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroEyebrow": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "heroDescription": {
      "type": "text",
      "required": true,
      "maxLength": 400
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "heroImageAlt": {
      "type": "string",
      "maxLength": 200
    },
    "heroCaptionEyebrow": {
      "type": "string",
      "maxLength": 80
    },
    "heroCaptionTitle": {
      "type": "string",
      "maxLength": 120
    },
    "heroCaptionTag": {
      "type": "string",
      "maxLength": 80
    },
    "introEyebrow": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "introTitle": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "introParagraphOne": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "introParagraphTwo": {
      "type": "text",
      "maxLength": 500
    },
    "introParagraphThree": {
      "type": "text",
      "maxLength": 700
    },
    "introStatement": {
      "type": "text",
      "maxLength": 400
    },
    "processEyebrow": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "processTitle": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "enquirySteps": {
      "type": "component",
      "component": "about.enquiry-step",
      "repeatable": true
    },
    "ctaEyebrow": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "ctaTitle": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "ctaDescription": {
      "type": "text",
      "maxLength": 300
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
