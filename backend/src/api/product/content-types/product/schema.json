{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "A domestic and export catalogue product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "sku": {
      "type": "string",
      "unique": true
    },
    "modelNumber": {
      "type": "string"
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "inversedBy": "products",
      "required": true
    },
    "applications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::application.application",
      "inversedBy": "products"
    },
    "certifications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::certification.certification",
      "inversedBy": "relatedProducts"
    },
    "relatedBlogPosts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "relatedProducts"
    },
    "seoLandingPages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::seo-landing-page.seo-landing-page",
      "mappedBy": "products"
    },
    "specifications": {
      "type": "component",
      "component": "product.specification",
      "repeatable": true
    },
    "features": {
      "type": "component",
      "component": "product.feature",
      "repeatable": true
    },
    "faqs": {
      "type": "component",
      "component": "shared.faq",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
