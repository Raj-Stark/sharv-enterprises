{
  "kind": "collectionType",
  "collectionName": "quotation_requests",
  "info": {
    "singularName": "quotation-request",
    "pluralName": "quotation-requests",
    "displayName": "Quotation Request",
    "description": "Unified quotation enquiries submitted by buyers"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "requestNumber": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 40
    },
    "submissionToken": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 64,
      "private": true
    },
    "fullName": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "whatsappNumber": {
      "type": "string",
      "required": true,
      "maxLength": 30
    },
    "recipientWhatsappNumber": {
      "type": "string",
      "required": true,
      "maxLength": 30,
      "private": true
    },
    "companyName": {
      "type": "string",
      "maxLength": 200
    },
    "deliveryDestination": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "items": {
      "type": "component",
      "component": "quotation.line-item",
      "repeatable": true,
      "required": true
    },
    "message": {
      "type": "text",
      "maxLength": 1000
    },
    "sourcePage": {
      "type": "string",
      "maxLength": 512
    },
    "referrer": {
      "type": "text",
      "maxLength": 2000
    },
    "utmSource": {
      "type": "string",
      "maxLength": 100
    },
    "utmMedium": {
      "type": "string",
      "maxLength": 100
    },
    "utmCampaign": {
      "type": "string",
      "maxLength": 150
    },
    "consentToContact": {
      "type": "boolean",
      "required": true
    },
    "whatsappStatus": {
      "type": "enumeration",
      "enum": [
        "initiated",
        "received"
      ],
      "required": true,
      "default": "initiated",
      "private": true
    },
    "whatsappInitiatedAt": {
      "type": "datetime",
      "required": true,
      "private": true
    },
    "whatsappReceivedAt": {
      "type": "datetime",
      "private": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "in_review",
        "quoted",
        "won",
        "lost",
        "spam"
      ],
      "required": true,
      "default": "new",
      "private": true
    },
    "internalNotes": {
      "type": "text",
      "private": true
    },
    "quotedAmount": {
      "type": "decimal",
      "min": 0,
      "private": true
    },
    "quotedCurrency": {
      "type": "enumeration",
      "enum": [
        "INR",
        "USD",
        "EUR",
        "GBP",
        "AED"
      ],
      "private": true
    },
    "quoteValidUntil": {
      "type": "date",
      "private": true
    }
  }
}
