      "type": "string",
      "required": true,
      "maxLength": 70
    },
    "metaDescription": {
      "type": "string",
      "required": true,
      "maxLength": 180
    },
    "ogTitle": {
      "type": "string",
      "maxLength": 70
    },
    "ogDescription": {
      "type": "string",
      "maxLength": 180
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    },
    "focusKeyword": {
      "type": "string"
    }
  }
}
