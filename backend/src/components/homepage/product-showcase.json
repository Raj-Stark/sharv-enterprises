{
  "collectionName": "components_homepage_product_showcases",
  "info": {
    "displayName": "Product Showcase",
    "description": "Controls the three-product visual catalogue displayed in the homepage hero"
  },
  "options": {},
  "attributes": {
    "badgeEyebrow": {
      "type": "string",
      "required": true,
      "default": "Built for business",
      "maxLength": 40
    },
    "badgeTitle": {
      "type": "string",
      "required": true,
      "default": "Pack · Protect · Dispatch",
      "maxLength": 70
    },
    "primaryProduct": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "required": true
    },
    "secondaryProduct": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "required": true
    },
    "tertiaryProduct": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "required": true
    },
    "footerEyebrow": {
      "type": "string",
      "required": true,
      "default": "Live catalogue",
      "maxLength": 40
    },
    "footerText": {
      "type": "string",
      "required": true,
      "default": "Compare products. Keep context in your quote.",
      "maxLength": 120
    },
    "ctaLabel": {
      "type": "string",
      "required": true,
      "default": "View all",
      "maxLength": 30
    }
  }
}
