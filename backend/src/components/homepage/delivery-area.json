        "export"
      ],
      "required": true,
      "default": "domestic"
    },
    "description": {
      "type": "text",
      "required": true,
      "maxLength": 280
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0
    }
  }
}
